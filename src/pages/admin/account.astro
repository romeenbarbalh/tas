---
import AdminLayout from "../../layouts/AdminLayout.astro";
---

<AdminLayout title="Compte">
  <div class="max-w-xl mx-auto space-y-8">

    <!-- Change Password -->
    <div class="bg-zinc-900 border border-zinc-800 rounded-2xl p-6">
      <h2 class="font-display text-lg font-semibold text-white mb-1">Changer le mot de passe</h2>
      <p class="text-sm text-zinc-400 mb-5">Modifiez votre propre mot de passe.</p>
      <form id="change-pw-form" class="space-y-4">
        <div>
          <label for="new-pw" class="block text-sm font-medium text-zinc-300 mb-1.5">Nouveau mot de passe</label>
          <input type="password" id="new-pw" required minlength="6"
            class="w-full px-4 py-2.5 bg-zinc-800 border border-zinc-700 rounded-lg text-white text-sm placeholder-zinc-500 focus:outline-none focus:ring-2 focus:ring-white/20 transition-colors"
            placeholder="6 caractères minimum" />
        </div>
        <div>
          <label for="confirm-pw" class="block text-sm font-medium text-zinc-300 mb-1.5">Confirmer</label>
          <input type="password" id="confirm-pw" required minlength="6"
            class="w-full px-4 py-2.5 bg-zinc-800 border border-zinc-700 rounded-lg text-white text-sm placeholder-zinc-500 focus:outline-none focus:ring-2 focus:ring-white/20 transition-colors"
            placeholder="Répétez le mot de passe" />
        </div>
        <div id="pw-msg" class="hidden text-sm rounded-lg px-4 py-2"></div>
        <button type="submit" id="pw-btn"
          class="w-full py-2.5 bg-white text-zinc-900 font-medium text-sm rounded-lg hover:bg-zinc-200 transition-colors disabled:opacity-50">
          Mettre à jour
        </button>
      </form>
    </div>

    <!-- Create User -->
    <div class="bg-zinc-900 border border-zinc-800 rounded-2xl p-6">
      <h2 class="font-display text-lg font-semibold text-white mb-1">Créer un compte</h2>
      <p class="text-sm text-zinc-400 mb-5">Ajoutez un nouvel utilisateur (coiffeur, admin...).</p>
      <form id="create-user-form" class="space-y-4">
        <div>
          <label for="new-email" class="block text-sm font-medium text-zinc-300 mb-1.5">Email</label>
          <input type="email" id="new-email" required
            class="w-full px-4 py-2.5 bg-zinc-800 border border-zinc-700 rounded-lg text-white text-sm placeholder-zinc-500 focus:outline-none focus:ring-2 focus:ring-white/20 transition-colors"
            placeholder="nom@email.com" />
        </div>
        <div>
          <label for="new-password" class="block text-sm font-medium text-zinc-300 mb-1.5">Mot de passe</label>
          <input type="password" id="new-password" required minlength="6"
            class="w-full px-4 py-2.5 bg-zinc-800 border border-zinc-700 rounded-lg text-white text-sm placeholder-zinc-500 focus:outline-none focus:ring-2 focus:ring-white/20 transition-colors"
            placeholder="6 caractères minimum" />
        </div>
        <div id="create-msg" class="hidden text-sm rounded-lg px-4 py-2"></div>
        <button type="submit" id="create-btn"
          class="w-full py-2.5 bg-white text-zinc-900 font-medium text-sm rounded-lg hover:bg-zinc-200 transition-colors disabled:opacity-50">
          Créer le compte
        </button>
      </form>
    </div>

    <!-- Users List -->
    <div class="bg-zinc-900 border border-zinc-800 rounded-2xl p-6">
      <h2 class="font-display text-lg font-semibold text-white mb-1">Utilisateurs</h2>
      <p class="text-sm text-zinc-400 mb-5">Comptes existants.</p>
      <div id="users-list" class="space-y-2">
        <p class="text-sm text-zinc-500 text-center py-4">Chargement...</p>
      </div>
    </div>

  </div>

  <script>
    import { supabase, getSupabase } from "../../lib/supabase";

    const pwForm = document.getElementById("change-pw-form") as HTMLFormElement;
    const newPw = document.getElementById("new-pw") as HTMLInputElement;
    const confirmPw = document.getElementById("confirm-pw") as HTMLInputElement;
    const pwMsg = document.getElementById("pw-msg")!;
    const pwBtn = document.getElementById("pw-btn") as HTMLButtonElement;

    const createForm = document.getElementById("create-user-form") as HTMLFormElement;
    const newEmail = document.getElementById("new-email") as HTMLInputElement;
    const newPassword = document.getElementById("new-password") as HTMLInputElement;
    const createMsg = document.getElementById("create-msg")!;
    const createBtn = document.getElementById("create-btn") as HTMLButtonElement;

    function showMsg(el: HTMLElement, text: string, ok: boolean) {
      el.textContent = text;
      el.className = `text-sm rounded-lg px-4 py-2 ${ok ? "bg-emerald-500/15 text-emerald-400 border border-emerald-500/20" : "bg-red-500/15 text-red-400 border border-red-500/20"}`;
    }

    pwForm.addEventListener("submit", async (e) => {
      e.preventDefault();
      pwMsg.className = "hidden";
      if (newPw.value !== confirmPw.value) {
        showMsg(pwMsg, "Les mots de passe ne correspondent pas.", false);
        return;
      }
      pwBtn.disabled = true;
      pwBtn.textContent = "Mise à jour...";
      const client = getSupabase();
      if (!client) { showMsg(pwMsg, "Supabase non configuré.", false); pwBtn.disabled = false; pwBtn.textContent = "Mettre à jour"; return; }
      const { error } = await client.auth.updateUser({ password: newPw.value });
      if (error) {
        showMsg(pwMsg, error.message, false);
      } else {
        showMsg(pwMsg, "Mot de passe modifié avec succès.", true);
        newPw.value = "";
        confirmPw.value = "";
      }
      pwBtn.disabled = false;
      pwBtn.textContent = "Mettre à jour";
    });

    createForm.addEventListener("submit", async (e) => {
      e.preventDefault();
      createMsg.className = "hidden";
      createBtn.disabled = true;
      createBtn.textContent = "Création...";
      const client = getSupabase();
      if (!client) { showMsg(createMsg, "Supabase non configuré.", false); createBtn.disabled = false; createBtn.textContent = "Créer le compte"; return; }
      const { error } = await client.auth.signUp({
        email: newEmail.value.trim(),
        password: newPassword.value,
      });
      if (error) {
        showMsg(createMsg, error.message, false);
      } else {
        showMsg(createMsg, "Compte créé avec succès !", true);
        createForm.reset();
        loadUsers();
      }
      createBtn.disabled = false;
      createBtn.textContent = "Créer le compte";
    });

    async function loadUsers() {
      const container = document.getElementById("users-list")!;
      const client = getSupabase();
      if (!client) { container.innerHTML = `<p class="text-sm text-zinc-500 text-center py-4">Supabase non configuré</p>`; return; }
      const { data } = await client.auth.getSession();
      const user = data?.session?.user;
      if (!user) {
        container.innerHTML = `<p class="text-sm text-zinc-500 text-center py-4">Non connecté</p>`;
        return;
      }
      container.innerHTML = `
        <div class="flex items-center justify-between p-3 bg-zinc-800/50 border border-zinc-700/50 rounded-xl">
          <div>
            <p class="text-sm font-medium text-white">${esc(user.email || "")}</p>
            <p class="text-xs text-zinc-400 mt-0.5">ID: ${user.id.slice(0, 8)}...</p>
          </div>
          <span class="text-xs px-2 py-1 rounded-full bg-emerald-500/15 text-emerald-400">Connecté</span>
        </div>
        <p class="text-xs text-zinc-500 text-center mt-3">Pour gérer tous les comptes, utilisez le <a href="https://supabase.com/dashboard" target="_blank" class="text-zinc-400 underline hover:text-white">Supabase Dashboard</a> → Authentication → Users</p>
      `;
    }

    function esc(str: string): string {
      const div = document.createElement("div");
      div.textContent = str;
      return div.innerHTML;
    }

    loadUsers();
  </script>
</AdminLayout>
