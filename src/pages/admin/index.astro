---
export const prerender = true;
import "../../styles/admin.css";
import { Scissors, Mail, Lock, ArrowRight } from "lucide-react";
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Connexion — The Ark Studio Admin</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Syne:wght@400;500;600;700;800&display=swap" />
  </head>

  <body class="relative flex min-h-screen items-center justify-center overflow-hidden">
    <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_at_top,rgba(255,255,255,0.06),transparent_60%)]" />

    <main class="relative z-10 w-full max-w-md px-4 py-10">
      <div class="mb-8 text-center">
        <div class="mx-auto mb-4 flex h-14 w-14 items-center justify-center rounded-full border border-gold/30 bg-gold/10 text-gold">
          <Scissors class="h-6 w-6" />
        </div>
        <h1 class="font-serif text-2xl font-bold tracking-tight text-white">
          The Ark <span class="text-gold">Studio</span>
        </h1>
        <p class="mt-1 text-sm text-muted">Espace administrateur</p>
      </div>

      <form id="login-form" class="rounded-2xl border border-white/10 bg-surface/80 p-6 shadow-xl shadow-black/40 backdrop-blur-xl space-y-4">
        <div>
          <label for="email" class="mb-1.5 block text-[11px] font-semibold uppercase tracking-wide text-muted">Email</label>
          <div class="relative">
            <Mail class="pointer-events-none absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-muted" />
            <input
              type="email"
              id="email"
              required
              autocomplete="email"
              class="w-full rounded-lg border border-white/10 bg-surface-2 py-2.5 pl-10 pr-4 text-sm text-white placeholder:text-muted/40 outline-none transition-colors focus:border-gold/50 focus:ring-1 focus:ring-gold/40"
              placeholder="admin@thearkstudio.be"
            />
          </div>
        </div>

        <div>
          <label for="password" class="mb-1.5 block text-[11px] font-semibold uppercase tracking-wide text-muted">Mot de passe</label>
          <div class="relative">
            <Lock class="pointer-events-none absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-muted" />
            <input
              type="password"
              id="password"
              required
              autocomplete="current-password"
              class="w-full rounded-lg border border-white/10 bg-surface-2 py-2.5 pl-10 pr-4 text-sm text-white placeholder:text-muted/40 outline-none transition-colors focus:border-gold/50 focus:ring-1 focus:ring-gold/40"
              placeholder="••••••••"
            />
          </div>
        </div>

        <div id="error-msg" class="hidden rounded-lg border border-red-500/30 bg-red-500/10 px-4 py-2 text-sm text-red-400"></div>

        <button
          type="submit"
          id="login-btn"
          class="flex w-full items-center justify-center gap-2 rounded-lg bg-gold py-2.5 text-sm font-semibold text-background transition-colors hover:bg-gold-light disabled:opacity-50 disabled:cursor-not-allowed"
        >
          Se connecter
          <ArrowRight class="h-4 w-4" />
        </button>
      </form>

      <p class="mt-6 text-center text-[11px] text-muted/60">
        Accès réservé — The Ark Studio · Verviers
      </p>
    </main>

    <script>
      import { supabase } from "../../lib/supabase";

      supabase.auth.getSession().then(({ data: { session } }) => {
        if (session) window.location.href = "/admin/dashboard/";
      });

      const form = document.getElementById("login-form") as HTMLFormElement;
      const emailInput = document.getElementById("email") as HTMLInputElement;
      const passwordInput = document.getElementById("password") as HTMLInputElement;
      const errorMsg = document.getElementById("error-msg")!;
      const loginBtn = document.getElementById("login-btn") as HTMLButtonElement;

      form.addEventListener("submit", async (e) => {
        e.preventDefault();
        errorMsg.classList.add("hidden");
        loginBtn.disabled = true;
        loginBtn.textContent = "Connexion...";

        const { error } = await supabase.auth.signInWithPassword({
          email: emailInput.value.trim(),
          password: passwordInput.value,
        });

        if (error) {
          errorMsg.textContent = error.message === "Invalid login credentials"
            ? "Email ou mot de passe incorrect"
            : error.message;
          errorMsg.classList.remove("hidden");
          loginBtn.disabled = false;
          loginBtn.textContent = "Se connecter";
        } else {
          window.location.href = "/admin/dashboard/";
        }
      });
    </script>
  </body>
</html>
