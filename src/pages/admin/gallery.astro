---
import AdminLayout from "../../layouts/AdminLayout.astro";
---

<AdminLayout title="Galerie">
  <div class="space-y-6">
    <!-- Header -->
    <div class="flex items-center justify-between">
      <div>
        <h1 class="font-display text-xl font-bold text-white">Galerie</h1>
        <p class="text-sm text-zinc-400 mt-1">Gérez les photos et vidéos de votre portfolio</p>
      </div>
      <button
        id="upload-btn"
        class="inline-flex items-center gap-2 px-4 py-2 bg-white text-zinc-900 text-sm font-medium rounded-lg hover:bg-zinc-200 transition-colors"
      >
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
        Ajouter
      </button>
      <input type="file" id="file-input" multiple accept="image/*,video/mp4,video/webm" class="hidden" />
    </div>

    <!-- Upload progress -->
    <div id="upload-progress" class="hidden bg-zinc-900 border border-zinc-800 rounded-xl p-4">
      <div class="flex items-center gap-3 mb-2">
        <div class="animate-spin w-4 h-4 border-2 border-white/20 border-t-white rounded-full"></div>
        <span id="upload-status" class="text-sm text-zinc-300">Upload en cours...</span>
      </div>
      <div class="h-1.5 bg-zinc-800 rounded-full overflow-hidden">
        <div id="upload-bar" class="h-full bg-white rounded-full transition-all duration-300" style="width: 0%"></div>
      </div>
    </div>

    <!-- Gallery grid -->
    <div id="gallery-grid" class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-3">
      <div class="col-span-full text-center py-12 text-zinc-500 text-sm">Chargement...</div>
    </div>

    <!-- Edit modal -->
    <div id="edit-modal" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4">
      <div class="absolute inset-0 bg-black/70 backdrop-blur-sm" id="modal-backdrop"></div>
      <div class="relative bg-zinc-900 border border-zinc-800 rounded-2xl p-6 w-full max-w-md space-y-4">
        <h3 class="font-display text-lg font-semibold text-white">Modifier</h3>
        <div>
          <label class="block text-sm text-zinc-300 mb-1">Titre (FR)</label>
          <input id="edit-alt-fr" type="text" class="w-full px-3 py-2 bg-zinc-800 border border-zinc-700 rounded-lg text-white text-sm focus:outline-none focus:ring-2 focus:ring-white/20" />
        </div>
        <div>
          <label class="block text-sm text-zinc-300 mb-1">Titre (EN)</label>
          <input id="edit-alt-en" type="text" class="w-full px-3 py-2 bg-zinc-800 border border-zinc-700 rounded-lg text-white text-sm focus:outline-none focus:ring-2 focus:ring-white/20" />
        </div>
        <div>
          <label class="block text-sm text-zinc-300 mb-1">Catégorie</label>
          <select id="edit-category" class="w-full px-3 py-2 bg-zinc-800 border border-zinc-700 rounded-lg text-white text-sm focus:outline-none focus:ring-2 focus:ring-white/20">
            <option value="men">Homme</option>
            <option value="women">Femme</option>
            <option value="braids">Tresses</option>
            <option value="kids">Enfant</option>
            <option value="other">Autre</option>
          </select>
        </div>
        <div class="flex gap-3 pt-2">
          <button id="modal-cancel" class="flex-1 py-2 text-sm rounded-lg bg-zinc-800 text-zinc-300 hover:bg-zinc-700 transition-colors">Annuler</button>
          <button id="modal-save" class="flex-1 py-2 text-sm rounded-lg bg-white text-zinc-900 font-medium hover:bg-zinc-200 transition-colors">Enregistrer</button>
        </div>
      </div>
    </div>
  </div>

  <style>
    @reference "../../styles/global.css";
    .gallery-item {
      position: relative;
      aspect-ratio: 4/5;
      border-radius: 0.75rem;
      overflow: hidden;
      background-color: rgb(39 39 42);
    }
    .gallery-item video,
    .gallery-item img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
    .gallery-overlay {
      position: absolute;
      inset: 0;
      background: linear-gradient(to top, rgba(0,0,0,0.8), transparent, transparent);
      opacity: 0;
      transition: opacity 0.2s;
      display: flex;
      flex-direction: column;
      justify-content: flex-end;
      padding: 0.75rem;
    }
    .gallery-item:hover .gallery-overlay { opacity: 1; }
    .gallery-actions {
      position: absolute;
      top: 0.5rem;
      right: 0.5rem;
      display: flex;
      gap: 0.375rem;
      opacity: 0;
      transition: opacity 0.2s;
    }
    .gallery-item:hover .gallery-actions { opacity: 1; }
    .gallery-actions button {
      padding: 0.375rem;
      border-radius: 0.5rem;
      background-color: rgba(0,0,0,0.6);
      backdrop-filter: blur(4px);
      color: rgba(255,255,255,0.7);
      transition: all 0.15s;
    }
    .gallery-actions button:hover { color: white; background-color: rgba(0,0,0,0.8); }
    .video-badge {
      position: absolute;
      top: 0.5rem;
      left: 0.5rem;
      padding: 2px 8px;
      border-radius: 0.375rem;
      background-color: rgba(0,0,0,0.6);
      backdrop-filter: blur(4px);
      font-size: 10px;
      font-weight: 500;
      color: rgba(255,255,255,0.8);
    }
  </style>

  <script>
    import { supabase } from "../../lib/supabase";

    // Auth guard
    supabase.auth.getSession().then(({ data: { session } }) => {
      if (!session) window.location.href = "/admin/";
    });

    interface GalleryItem {
      id: string;
      file_url: string;
      file_type: "image" | "video";
      alt_fr: string;
      alt_en: string;
      category: string;
      sort_order: number;
      created_at: string;
    }

    let items: GalleryItem[] = [];
    let editingId: string | null = null;

    const galleryGrid = document.getElementById("gallery-grid")!;
    const uploadBtn = document.getElementById("upload-btn")!;
    const fileInput = document.getElementById("file-input") as HTMLInputElement;
    const uploadProgress = document.getElementById("upload-progress")!;
    const uploadStatus = document.getElementById("upload-status")!;
    const uploadBar = document.getElementById("upload-bar")!;
    const editModal = document.getElementById("edit-modal")!;
    const modalBackdrop = document.getElementById("modal-backdrop")!;
    const modalCancel = document.getElementById("modal-cancel")!;
    const modalSave = document.getElementById("modal-save")!;
    const editAltFr = document.getElementById("edit-alt-fr") as HTMLInputElement;
    const editAltEn = document.getElementById("edit-alt-en") as HTMLInputElement;
    const editCategory = document.getElementById("edit-category") as HTMLSelectElement;

    async function loadItems() {
      const { data } = await supabase
        .from("gallery_items")
        .select("*")
        .order("sort_order", { ascending: true });

      items = (data as GalleryItem[]) || [];
      render();
    }

    function render() {
      if (items.length === 0) {
        galleryGrid.innerHTML = `<div class="col-span-full text-center py-12 text-zinc-500 text-sm">
          <svg class="mx-auto mb-3 text-zinc-600" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
          Aucun média. Cliquez sur "Ajouter" pour commencer.
        </div>`;
        return;
      }

      galleryGrid.innerHTML = items.map(item => `
        <div class="gallery-item" data-id="${item.id}">
          ${item.file_type === "video"
            ? `<video src="${escAttr(item.file_url)}" muted loop preload="metadata" playsinline></video>
               <span class="video-badge">VIDEO</span>`
            : `<img src="${escAttr(item.file_url)}" alt="${escAttr(item.alt_fr)}" loading="lazy" />`
          }
          <div class="gallery-overlay">
            <p class="text-xs text-white/80 line-clamp-2">${escHtml(item.alt_fr)}</p>
            <p class="text-[10px] text-white/50 mt-0.5">${escHtml(item.category)}</p>
          </div>
          <div class="gallery-actions">
            <button data-edit="${item.id}" title="Modifier">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
            </button>
            <button data-delete="${item.id}" title="Supprimer">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
            </button>
          </div>
        </div>
      `).join("");

      // Hover play for videos
      galleryGrid.querySelectorAll<HTMLVideoElement>(".gallery-item video").forEach(vid => {
        vid.closest(".gallery-item")?.addEventListener("mouseenter", () => vid.play());
        vid.closest(".gallery-item")?.addEventListener("mouseleave", () => { vid.pause(); vid.currentTime = 0; });
      });

      // Edit buttons
      galleryGrid.querySelectorAll("[data-edit]").forEach(btn => {
        btn.addEventListener("click", () => openEdit((btn as HTMLElement).dataset.edit!));
      });

      // Delete buttons
      galleryGrid.querySelectorAll("[data-delete]").forEach(btn => {
        btn.addEventListener("click", () => deleteItem((btn as HTMLElement).dataset.delete!));
      });
    }

    uploadBtn.addEventListener("click", () => fileInput.click());

    fileInput.addEventListener("change", async () => {
      const files = fileInput.files;
      if (!files || files.length === 0) return;

      uploadProgress.classList.remove("hidden");

      for (let i = 0; i < files.length; i++) {
        const file = files[i];
        const isVideo = file.type.startsWith("video/");
        const ext = file.name.split(".").pop() || (isVideo ? "mp4" : "jpg");
        const filePath = `gallery/${Date.now()}-${Math.random().toString(36).slice(2, 8)}.${ext}`;

        uploadStatus.textContent = `${i + 1}/${files.length} — ${file.name}`;
        uploadBar.style.width = `${((i) / files.length) * 100}%`;

        const { data: uploadData, error: uploadError } = await supabase.storage
          .from("media")
          .upload(filePath, file);

        if (uploadError) {
          console.error("Upload error:", uploadError);
          continue;
        }

        const { data: urlData } = supabase.storage.from("media").getPublicUrl(filePath);

        await supabase.from("gallery_items").insert({
          file_url: urlData.publicUrl,
          file_type: isVideo ? "video" : "image",
          alt_fr: file.name.replace(/\.[^.]+$/, ""),
          alt_en: file.name.replace(/\.[^.]+$/, ""),
          category: "other",
          sort_order: items.length + i,
        });
      }

      uploadBar.style.width = "100%";
      uploadStatus.textContent = "Terminé !";
      setTimeout(() => uploadProgress.classList.add("hidden"), 1500);

      fileInput.value = "";
      await loadItems();
    });

    function openEdit(id: string) {
      const item = items.find(i => i.id === id);
      if (!item) return;
      editingId = id;
      editAltFr.value = item.alt_fr;
      editAltEn.value = item.alt_en;
      editCategory.value = item.category;
      editModal.classList.remove("hidden");
    }

    modalBackdrop.addEventListener("click", () => editModal.classList.add("hidden"));
    modalCancel.addEventListener("click", () => editModal.classList.add("hidden"));

    modalSave.addEventListener("click", async () => {
      if (!editingId) return;
      await supabase.from("gallery_items").update({
        alt_fr: editAltFr.value,
        alt_en: editAltEn.value,
        category: editCategory.value,
      }).eq("id", editingId);
      editModal.classList.add("hidden");
      await loadItems();
    });

    async function deleteItem(id: string) {
      if (!confirm("Supprimer ce média ?")) return;
      const item = items.find(i => i.id === id);
      if (item) {
        // Extract storage path from URL
        const url = new URL(item.file_url);
        const path = url.pathname.split("/object/public/media/")[1];
        if (path) await supabase.storage.from("media").remove([path]);
      }
      await supabase.from("gallery_items").delete().eq("id", id);
      await loadItems();
    }

    function escHtml(str: string): string {
      const div = document.createElement("div");
      div.textContent = str;
      return div.innerHTML;
    }

    function escAttr(str: string): string {
      return str.replace(/"/g, "&quot;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
    }

    loadItems();
  </script>
</AdminLayout>
