---
export const prerender = true;
import AdminLayout from "../../layouts/AdminLayout.astro";
import DailyFinancialCard from "../../components/admin/DailyFinancialCard";
import AvailabilityManager from "../../components/admin/AvailabilityManager";
import ServicesManager from "../../components/admin/ServicesManager";
import { CalendarDays, LayoutDashboard, List, Scissors, TrendingUp, Users } from "lucide-react";
---

<AdminLayout title="Rendez-vous">
  <div id="app" class="space-y-6">
    <!-- Stats -->
    <div class="grid grid-cols-2 gap-4 lg:grid-cols-4">
      <div class="rounded-2xl border border-white/8 bg-surface p-5">
        <p class="flex items-center gap-2 text-xs font-semibold uppercase tracking-wide text-muted">
          En attente
        </p>
        <p class="mt-2 font-serif text-3xl text-gold" id="stat-pending">0</p>
      </div>
      <div class="rounded-2xl border border-white/8 bg-surface p-5">
        <p class="flex items-center gap-2 text-xs font-semibold uppercase tracking-wide text-muted">
          Confirmées
        </p>
        <p class="mt-2 font-serif text-3xl text-emerald-400" id="stat-confirmed">0</p>
      </div>
      <div class="rounded-2xl border border-white/8 bg-surface p-5">
        <p class="flex items-center gap-2 text-xs font-semibold uppercase tracking-wide text-muted">
          Annulées
        </p>
        <p class="mt-2 font-serif text-3xl text-red-400" id="stat-cancelled">0</p>
      </div>
      <div class="rounded-2xl border border-white/8 bg-surface p-5">
        <p class="flex items-center gap-2 text-xs font-semibold uppercase tracking-wide text-muted">
          Total
        </p>
        <p class="mt-2 font-serif text-3xl text-white" id="stat-total">0</p>
      </div>
    </div>

    <!-- Debug banner -->
    <div id="debug-banner" class="hidden rounded-xl border border-red-500/30 bg-red-500/10 p-4 text-sm text-red-400"></div>

    <!-- Tabs -->
    <div class="flex gap-1 overflow-x-auto pb-1">
      <button id="tab-list" class="inline-flex shrink-0 items-center gap-2 rounded-full px-4 py-2 text-sm font-semibold transition-colors">
        <List class="h-4 w-4" />
        Liste
      </button>
      <button id="tab-calendar" class="inline-flex shrink-0 items-center gap-2 rounded-full px-4 py-2 text-sm font-semibold text-muted transition-colors hover:text-white">
        <CalendarDays class="h-4 w-4" />
        Calendrier
      </button>
      <button id="tab-resume" class="inline-flex shrink-0 items-center gap-2 rounded-full px-4 py-2 text-sm font-semibold text-muted transition-colors hover:text-white">
        <TrendingUp class="h-4 w-4" />
        Résumé
      </button>
      <button id="tab-dispo" class="inline-flex shrink-0 items-center gap-2 rounded-full px-4 py-2 text-sm font-semibold text-muted transition-colors hover:text-white">
        <LayoutDashboard class="h-4 w-4" />
        Disponibilités
      </button>
      <button id="tab-services" class="inline-flex shrink-0 items-center gap-2 rounded-full px-4 py-2 text-sm font-semibold text-muted transition-colors hover:text-white">
        <Scissors class="h-4 w-4" />
        Services
      </button>
    </div>

    <!-- LIST VIEW -->
    <div id="view-list">
      <div class="flex flex-wrap gap-2">
        <button data-filter="all" class="filter-btn inline-flex items-center gap-1.5 rounded-full px-3 py-1.5 text-xs font-semibold transition-colors">
          Tous
        </button>
        <button data-filter="pending" class="filter-btn inline-flex items-center gap-1.5 rounded-full px-3 py-1.5 text-xs font-semibold text-muted transition-colors hover:text-white">
          En attente
        </button>
        <button data-filter="confirmed" class="filter-btn inline-flex items-center gap-1.5 rounded-full px-3 py-1.5 text-xs font-semibold text-muted transition-colors hover:text-white">
          Confirmées
        </button>
        <button data-filter="cancelled" class="filter-btn inline-flex items-center gap-1.5 rounded-full px-3 py-1.5 text-xs font-semibold text-muted transition-colors hover:text-white">
          Annulées
        </button>
      </div>

      <div id="bookings-list" class="mt-4 space-y-3">
        <div class="rounded-xl border border-white/8 bg-surface p-4 text-sm text-muted text-center py-10">
          Chargement...
        </div>
      </div>
    </div>

    <!-- CALENDAR VIEW -->
    <div id="view-calendar" class="hidden">
      <div class="grid gap-6 lg:grid-cols-[1fr_380px]">
        <div class="rounded-2xl border border-white/8 bg-surface p-5">
          <div class="mb-4 flex items-center justify-between">
            <button id="prev-month" class="rounded-lg p-2 text-muted transition-colors hover:bg-surface-2 hover:text-gold">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
            </button>
            <h2 id="calendar-title" class="font-serif text-lg font-semibold text-white"></h2>
            <button id="next-month" class="rounded-lg p-2 text-muted transition-colors hover:bg-surface-2 hover:text-gold">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
            </button>
          </div>
          <div class="mb-2 grid grid-cols-7 gap-1">
            {["Lun","Mar","Mer","Jeu","Ven","Sam","Dim"].map(d => (
              <div class="py-1 text-center text-[11px] font-medium text-muted">{d}</div>
            ))}
          </div>
          <div id="calendar-grid" class="grid grid-cols-7 gap-1"></div>
        </div>

        <div class="rounded-2xl border border-white/8 bg-surface p-5">
          <h3 id="selected-date-title" class="mb-1 font-serif text-base font-semibold text-white">Aujourd'hui</h3>
          <p id="selected-date-subtitle" class="mb-4 text-xs text-muted">Sélectionnez un jour</p>
          <div id="day-bookings" class="max-h-[500px] space-y-3 overflow-y-auto pr-1">
            <p class="py-8 text-center text-sm text-muted">Aucune réservation</p>
          </div>
        </div>
      </div>
    </div>

    <!-- RESUME VIEW -->
    <div id="view-resume" class="hidden">
      <div class="rounded-2xl border border-white/8 bg-surface p-5">
        <DailyFinancialCard client:load />
      </div>
    </div>

    <!-- DISPONIBILITES VIEW -->
    <div id="view-dispo" class="hidden">
      <div class="rounded-2xl border border-white/8 bg-surface p-5">
        <AvailabilityManager client:load />
      </div>
    </div>

    <!-- SERVICES VIEW -->
    <div id="view-services" class="hidden">
      <div class="rounded-2xl border border-white/8 bg-surface p-5">
        <ServicesManager client:load />
      </div>
    </div>
  </div>

  <style>
    @reference "../../styles/admin.css";
    .day-cell {
      position: relative;
      aspect-ratio: 1;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      border-radius: 0.5rem;
      font-size: 0.875rem;
      cursor: pointer;
      transition: all 0.15s;
    }
    .day-cell:hover { background-color: rgba(25, 25, 29, 0.9); }
    .day-cell.today { box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.5); }
    .day-cell.selected { background-color: rgba(255, 255, 255, 0.15); color: #ffffff; font-weight: 600; border: 1px solid rgba(255, 255, 255, 0.4); }
    .day-cell.other-month { color: rgb(63 63 70); }
    .day-cell.has-bookings::after {
      content: "";
      position: absolute;
      bottom: 4px;
      width: 4px;
      height: 4px;
      border-radius: 9999px;
      background-color: #ffffff;
    }
    .day-cell.has-confirmed::after { background-color: rgb(255 255 255); }
    .status-badge {
      display: inline-flex;
      align-items: center;
      padding: 3px 10px;
      border-radius: 9999px;
      font-size: 11px;
      font-weight: 600;
      border: 1px solid;
    }
    .status-pending { background-color: rgba(255, 255, 255, 0.12); color: #ffffff; border-color: rgba(255, 255, 255, 0.4); }
    .status-confirmed { background-color: rgba(255, 255, 255, 0.12); color: rgb(255 255 255); border-color: rgba(255, 255, 255, 0.4); }
    .status-cancelled { background-color: rgba(255, 255, 255, 0.08); color: rgb(212 212 216); border-color: rgba(255, 255, 255, 0.25); }

    #tab-list.active, .filter-btn.active {
      background-color: rgba(255, 255, 255, 0.12);
      color: #ffffff;
      border: 1px solid rgba(255, 255, 255, 0.4);
    }
    #tab-calendar.active, #tab-resume.active, #tab-dispo.active, #tab-services.active {
      background-color: rgba(255, 255, 255, 0.12);
      color: #ffffff;
      border: 1px solid rgba(255, 255, 255, 0.4);
    }
  </style>

  <script>
    import { supabase } from "../../lib/supabase";

    supabase.auth.getSession().then(({ data: { session } }) => {
      if (!session) window.location.href = "/admin/";
    });

    interface Booking {
      id: string;
      client_name: string;
      client_email: string;
      client_phone: string;
      services: string[];
      total_price: number;
      booking_date: string;
      booking_time: string;
      barber: string;
      status: "pending" | "confirmed" | "cancelled";
      notes: string | null;
      created_at: string;
    }

    const MONTHS_FR = ["Janvier","Février","Mars","Avril","Mai","Juin","Juillet","Août","Septembre","Octobre","Novembre","Décembre"];
    let currentDate = new Date();
    let selectedDate = new Date();
    let allBookings: Booking[] = [];
    let currentFilter = "all";

    const debugBanner = document.getElementById("debug-banner")!;

    function showDebug(msg: string) {
      debugBanner.textContent = msg;
      debugBanner.classList.remove("hidden");
    }

    async function loadBookings() {
      const { data, error } = await supabase
        .from("bookings")
        .select("*")
        .order("booking_date", { ascending: false });

      if (error) {
        showDebug(`Erreur Supabase: ${error.message} (Code: ${error.code}). Vérifiez que la table "bookings" existe et que les policies RLS sont configurées.`);
        console.error("Supabase error:", error);
        allBookings = [];
      } else {
        debugBanner.classList.add("hidden");
        allBookings = (data as Booking[]) || [];
      }

      updateStats();
      renderList();
      renderCalendar();
    }

    function updateStats() {
      const pending = allBookings.filter(b => b.status === "pending").length;
      const confirmed = allBookings.filter(b => b.status === "confirmed").length;
      const cancelled = allBookings.filter(b => b.status === "cancelled").length;
      document.getElementById("stat-pending")!.textContent = String(pending);
      document.getElementById("stat-confirmed")!.textContent = String(confirmed);
      document.getElementById("stat-cancelled")!.textContent = String(cancelled);
      document.getElementById("stat-total")!.textContent = String(allBookings.length);
    }

    /* ─── LIST VIEW ─── */
    function renderList() {
      const list = document.getElementById("bookings-list")!;
      const filtered = currentFilter === "all" ? allBookings : allBookings.filter(b => b.status === currentFilter);

      if (filtered.length === 0) {
        list.innerHTML = `<div class="rounded-xl border border-white/8 bg-surface p-4 text-center py-12 text-sm text-muted">
          ${currentFilter === "all" ? "Aucune réservation pour le moment" : "Aucune réservation avec ce statut"}
        </div>`;
        return;
      }

      list.innerHTML = filtered.map(b => {
        const d = new Date(b.booking_date + "T00:00:00");
        const dateStr = d.toLocaleDateString("fr-FR", { day: "numeric", month: "short", year: "numeric" });

        return `
          <div class="rounded-xl border border-white/8 bg-surface p-4 transition-colors hover:border-gold/30">
            <div class="flex flex-wrap items-start justify-between gap-3">
              <div class="flex items-center gap-3">
                <span class="flex h-10 w-10 items-center justify-center rounded-full border border-gold/30 bg-gold/10 text-gold">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                </span>
                <div>
                  <p class="font-semibold text-white">${esc(b.client_name)}</p>
                  <p class="mt-0.5 text-xs text-muted">${esc(b.services.join(", "))}${b.barber ? ` · ${esc(b.barber)}` : ""}</p>
                </div>
              </div>
              <div class="text-right">
                <span class="status-badge status-${b.status}">${statusLabel(b.status)}</span>
                <p class="mt-1 text-xs text-muted">${dateStr} à ${b.booking_time}</p>
                <p class="font-semibold text-gold">${b.total_price} €</p>
              </div>
            </div>

            <div class="mt-3 flex flex-wrap gap-x-4 gap-y-1 text-xs text-muted">
              <span class="flex items-center gap-1.5">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-gold"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
                ${esc(b.client_phone)}
              </span>
              ${b.client_email ? `
                <span class="flex items-center gap-1.5">
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-gold"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
                  ${esc(b.client_email)}
                </span>
              ` : ""}
              ${b.notes ? `
                <span class="flex items-center gap-1.5">
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-gold"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
                  ${esc(b.notes)}
                </span>
              ` : ""}
            </div>

            <div class="mt-3 flex flex-wrap gap-2">
              ${b.status === "pending" ? `
                <button data-confirm="${b.id}" class="inline-flex items-center gap-1.5 rounded-lg border border-emerald-500/30 bg-emerald-500/10 px-3 py-1.5 text-xs font-semibold text-emerald-400 transition-colors hover:bg-emerald-500/20">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                  Confirmer
                </button>
                <button data-cancel="${b.id}" class="inline-flex items-center gap-1.5 rounded-lg border border-red-500/30 bg-red-500/10 px-3 py-1.5 text-xs font-semibold text-red-400 transition-colors hover:bg-red-500/20">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="4.9" y1="4.9" x2="19.1" y2="19.1"/></svg>
                  Annuler
                </button>
              ` : `
                <button data-delete="${b.id}" class="inline-flex items-center gap-1.5 rounded-lg border border-white/10 px-3 py-1.5 text-xs font-semibold text-muted transition-colors hover:border-red-500/30 hover:text-red-400">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
                  Supprimer
                </button>
              `}
            </div>
          </div>`;
      }).join("");

      bindActions(list);
    }

    function bindActions(container: HTMLElement) {
      container.querySelectorAll("[data-confirm]").forEach(btn => {
        btn.addEventListener("click", async () => {
          const id = (btn as HTMLElement).dataset.confirm!;
          await supabase.from("bookings").update({ status: "confirmed" }).eq("id", id);
          await loadBookings();
        });
      });
      container.querySelectorAll("[data-cancel]").forEach(btn => {
        btn.addEventListener("click", async () => {
          const id = (btn as HTMLElement).dataset.cancel!;
          await supabase.from("bookings").update({ status: "cancelled" }).eq("id", id);
          await loadBookings();
        });
      });
      container.querySelectorAll("[data-delete]").forEach(btn => {
        btn.addEventListener("click", async () => {
          if (!confirm("Supprimer cette réservation ?")) return;
          const id = (btn as HTMLElement).dataset.delete!;
          await supabase.from("bookings").delete().eq("id", id);
          await loadBookings();
        });
      });
    }

    /* ─── CALENDAR VIEW ─── */
    function renderCalendar() {
      const year = currentDate.getFullYear();
      const month = currentDate.getMonth();
      document.getElementById("calendar-title")!.textContent = `${MONTHS_FR[month]} ${year}`;

      const firstDay = new Date(year, month, 1);
      const lastDay = new Date(year, month + 1, 0);
      const startDay = (firstDay.getDay() + 6) % 7;
      const daysInMonth = lastDay.getDate();
      const todayStr = formatDate(new Date());
      const selectedStr = formatDate(selectedDate);

      let html = "";
      const prevMonthLast = new Date(year, month, 0).getDate();
      for (let i = startDay - 1; i >= 0; i--) {
        html += `<div class="day-cell other-month">${prevMonthLast - i}</div>`;
      }
      for (let d = 1; d <= daysInMonth; d++) {
        const dateStr = formatDate(new Date(year, month, d));
        const dayBookings = allBookings.filter(b => b.booking_date === dateStr);
        const hasPending = dayBookings.some(b => b.status === "pending");
        const hasConfirmed = dayBookings.some(b => b.status === "confirmed");
        const classes = [
          "day-cell",
          dateStr === todayStr ? "today" : "",
          dateStr === selectedStr ? "selected" : "",
          dayBookings.length > 0 ? (hasConfirmed && !hasPending ? "has-confirmed" : "has-bookings") : "",
        ].filter(Boolean).join(" ");
        html += `<div class="${classes}" data-date="${dateStr}">${d}</div>`;
      }
      const totalCells = startDay + daysInMonth;
      const remaining = totalCells % 7 === 0 ? 0 : 7 - (totalCells % 7);
      for (let i = 1; i <= remaining; i++) {
        html += `<div class="day-cell other-month">${i}</div>`;
      }

      document.getElementById("calendar-grid")!.innerHTML = html;

      document.querySelectorAll<HTMLElement>("[data-date]").forEach(cell => {
        cell.addEventListener("click", () => {
          selectedDate = new Date(cell.dataset.date + "T00:00:00");
          renderCalendar();
          renderDayBookings();
        });
      });
    }

    function renderDayBookings() {
      const dateStr = formatDate(selectedDate);
      const dayBookings = allBookings.filter(b => b.booking_date === dateStr);
      document.getElementById("selected-date-title")!.textContent = selectedDate.toLocaleDateString("fr-FR", { weekday: "long", day: "numeric", month: "long" });
      document.getElementById("selected-date-subtitle")!.textContent = `${dayBookings.length} réservation${dayBookings.length !== 1 ? "s" : ""}`;

      const container = document.getElementById("day-bookings")!;
      if (dayBookings.length === 0) {
        container.innerHTML = `<p class="py-8 text-center text-sm text-muted">Aucune réservation ce jour</p>`;
        return;
      }

      container.innerHTML = dayBookings.map(b => `
        <div class="space-y-2 rounded-xl border border-white/8 bg-surface-2 p-3.5">
          <div class="flex items-start justify-between gap-2">
            <div>
              <p class="text-sm font-medium text-white">${esc(b.client_name)}</p>
              <p class="mt-0.5 text-xs text-muted">${esc(b.client_phone)}</p>
            </div>
            <span class="status-badge status-${b.status}">${statusLabel(b.status)}</span>
          </div>
          <div class="space-y-0.5 text-xs text-muted">
            <p class="font-medium text-white">${b.booking_time}</p>
            <p>${esc(b.services.join(", "))}</p>
            <p class="font-medium text-gold">${b.total_price}€</p>
          </div>
          ${b.status === "pending" ? `
            <div class="flex gap-2 pt-1">
              <button data-confirm="${b.id}" class="flex-1 rounded-lg bg-emerald-500/10 py-1.5 text-xs font-medium text-emerald-400 transition-colors hover:bg-emerald-500/20">Confirmer</button>
              <button data-cancel="${b.id}" class="flex-1 rounded-lg bg-red-500/10 py-1.5 text-xs font-medium text-red-400 transition-colors hover:bg-red-500/20">Annuler</button>
            </div>
          ` : `
            <button data-delete="${b.id}" class="mt-1 w-full rounded-lg bg-surface py-1.5 text-xs font-medium text-muted transition-colors hover:text-red-400">Supprimer</button>
          `}
        </div>
      `).join("");

      bindActions(container);
    }

    /* ─── HELPERS ─── */
    function formatDate(d: Date): string {
      return `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, "0")}-${String(d.getDate()).padStart(2, "0")}`;
    }

    function statusLabel(s: string): string {
      return s === "pending" ? "En attente" : s === "confirmed" ? "Confirmée" : "Annulée";
    }

    function esc(str: string): string {
      const div = document.createElement("div");
      div.textContent = str || "";
      return div.innerHTML;
    }

    /* ─── TABS ─── */
    const tabList = document.getElementById("tab-list")!;
    const tabCal = document.getElementById("tab-calendar")!;
    const tabResume = document.getElementById("tab-resume")!;
    const tabDispo = document.getElementById("tab-dispo")!;
    const tabServices = document.getElementById("tab-services")!;
    const viewList = document.getElementById("view-list")!;
    const viewCal = document.getElementById("view-calendar")!;
    const viewResume = document.getElementById("view-resume")!;
    const viewDispo = document.getElementById("view-dispo")!;
    const viewServices = document.getElementById("view-services")!;

    const tabs = [tabList, tabCal, tabResume, tabDispo, tabServices];
    const views = [viewList, viewCal, viewResume, viewDispo, viewServices];

    function setActiveTab(active: string) {
      tabs.forEach(t => t.classList.remove("active"));
      views.forEach(v => v.classList.add("hidden"));
      const map: Record<string, [typeof tabList, typeof viewList]> = {
        list: [tabList, viewList],
        calendar: [tabCal, viewCal],
        resume: [tabResume, viewResume],
        dispo: [tabDispo, viewDispo],
        services: [tabServices, viewServices],
      };
      const [tab, view] = map[active] || map.list;
      tab.classList.add("active");
      view.classList.remove("hidden");
    }

    tabList.addEventListener("click", () => { setActiveTab("list"); renderList(); });
    tabCal.addEventListener("click", () => { setActiveTab("calendar"); renderCalendar(); renderDayBookings(); });
    tabResume.addEventListener("click", () => setActiveTab("resume"));
    tabDispo.addEventListener("click", () => setActiveTab("dispo"));
    tabServices.addEventListener("click", () => setActiveTab("services"));

    document.getElementById("prev-month")!.addEventListener("click", () => {
      currentDate.setMonth(currentDate.getMonth() - 1);
      renderCalendar();
    });
    document.getElementById("next-month")!.addEventListener("click", () => {
      currentDate.setMonth(currentDate.getMonth() + 1);
      renderCalendar();
    });

    /* ─── FILTERS ─── */
    document.querySelectorAll("[data-filter]").forEach(btn => {
      btn.addEventListener("click", () => {
        currentFilter = (btn as HTMLElement).dataset.filter!;
        document.querySelectorAll("[data-filter]").forEach(b => b.classList.remove("active"));
        btn.classList.add("active");
        renderList();
      });
    });

    /* ─── INIT ─── */
    setActiveTab("list");
    loadBookings();
  </script>
</AdminLayout>
