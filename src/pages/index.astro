---
export const prerender = true;
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";
import MobileStickyCTA from "../components/layout/MobileStickyCTA.astro";
import Hero from "../components/sections/Hero.astro";
import Intro2 from "../components/sections/Intro2.astro";
import Booking from "../components/sections/Booking.astro";
import Services from "../components/sections/Services.astro";
import Team from "../components/sections/Team.astro";
import About from "../components/sections/About.astro";
import Hours from "../components/sections/Hours.astro";
import Gallery from "../components/sections/Gallery.astro";
import { t as getT } from "../utils/i18n";

const locale = "fr" as const;
const t = (key: string) => getT(locale, key);
---

<BaseLayout title={t("nav.home")} locale={locale}>
  <Header locale={locale} t={t} />
  <main>
    <Hero locale={locale} t={t} />
    <Intro2 locale={locale} t={t} />
    <Booking locale={locale} t={t} />
    <Services locale={locale} t={t} />
    <Team locale={locale} t={t} />
    <About locale={locale} t={t} />
    <Hours locale={locale} t={t} />
    <Gallery locale={locale} t={t} />
  </main>
  <Footer locale={locale} t={t} />
  <MobileStickyCTA locale={locale} t={t} />
</BaseLayout>