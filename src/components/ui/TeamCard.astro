---
interface Props {
  member: {
    id: string;
    name: string;
    role: { fr: string; en: string };
    specialty: { fr: string; en: string };
    services: string[];
    instagram: string;
    image: string;
  };
  locale: "fr" | "en";
  index: number;
}
const { member, locale, index } = Astro.props;
const staggerClass = `stagger-${(index % 7) + 1}`;
---

<article class={`card group animate-in ${staggerClass}`}>
  <!-- Image -->
  <div class="aspect-square overflow-hidden relative">
    <img
      src={member.image}
      alt=""
      class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
      loading="lazy"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-bg/80 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300" aria-hidden="true"></div>

    <!-- Instagram Link -->
    <a
      href={member.instagram}
      target="_blank"
      rel="noopener noreferrer"
      class="absolute bottom-2 right-2 md:bottom-4 md:right-4 p-1.5 md:p-2 rounded-full bg-bg/90 backdrop-blur-sm border border-border text-text-muted hover:text-gold hover:border-gold/50 transform translate-y-4 opacity-0 group-hover:translate-y-0 group-hover:opacity-100 transition-all duration-300"
      aria-label={`Instagram de ${member.name}`}
    >
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="20" x="2" y="2" rx="5" ry="5"></rect><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line></svg>
    </a>
  </div>

  <!-- Content -->
  <div class="p-2.5 md:p-5">
    <h3 class="text-sm md:heading-sm text-text leading-tight">{member.name}</h3>
    <p class="text-[10px] md:text-sm text-gold font-medium mt-0.5 md:mt-1">{member.role[locale]}</p>
    <p class="text-[10px] md:text-sm text-text-muted mt-1 md:mt-2 line-clamp-1 md:line-clamp-2 hidden md:block">{member.specialty[locale]}</p>
  </div>
</article>
