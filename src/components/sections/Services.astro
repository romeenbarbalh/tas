---
interface Props {
  locale: "fr" | "en";
  t: (key: string) => string;
}
const { locale, t } = Astro.props;
import { services, categories } from "../../utils/constants";
import ServiceCard from "../ui/ServiceCard.astro";

const categoryIds = categories.map(c => c.id);
const labelMap: Record<string, { fr: string; en: string }> = {};
for (const c of categories) labelMap[c.id] = c.label;

const servicesByCategory: Record<string, typeof services> = {};
for (const cat of categories) {
  servicesByCategory[cat.id] = services.filter(s => s.category === cat.id);
}
const MOBILE_PAGE_SIZE = 3;
---

<section id="services" class="section" aria-labelledby="services-title">
  <div class="container">
    <header class="text-center max-w-2xl mx-auto mb-4 md:mb-12">
      <h2 id="services-title" class="heading-lg mb-1 md:mb-4">{t("services.title")}</h2>
      <p class="text-body hidden md:block">{t("services.subtitle")}</p>
    </header>

    <!-- Category Tabs -->
    <div class="flex flex-wrap items-center justify-center gap-1.5 md:gap-2 mb-4 md:mb-10" role="tablist" aria-label={locale === "fr" ? "Catégories de services" : "Service categories"}>
      {categories.map((cat, i) => (
        <button
          role="tab"
          aria-selected={i === 0}
          aria-controls={`panel-${cat.id}`}
          id={`tab-${cat.id}`}
          data-category={cat.id}
          class={`px-3 md:px-5 py-1.5 md:py-2.5 rounded-full text-xs md:text-sm font-medium transition-all ${
            i === 0
              ? "bg-gold text-bg shadow-lg shadow-gold/20"
              : "bg-bg-elevated text-text-muted hover:text-text hover:bg-bg-card hover:border-gold/50 border border-border"
          }`}
        >
          {cat.label[locale]}
        </button>
      ))}
    </div>

    <!-- Panels -->
    <div class="space-y-3 md:space-y-8">
      {categories.map((cat, i) => {
        const catServices = servicesByCategory[cat.id] || [];
        const pages: typeof catServices[] = [];
        for (let p = 0; p < catServices.length; p += MOBILE_PAGE_SIZE) {
          pages.push(catServices.slice(p, p + MOBILE_PAGE_SIZE));
        }
        return (
          <div
            role="tabpanel"
            id={`panel-${cat.id}`}
            aria-labelledby={`tab-${cat.id}`}
            class={`${i !== 0 ? "hidden" : ""} animate-in`}
            data-panel={cat.id}
          >
            <!-- Desktop: normal grid -->
            <div class="hidden md:grid md:grid-cols-2 lg:grid-cols-3 gap-4 lg:gap-6">
              {catServices.map((service, idx) => (
                <ServiceCard service={service} locale={locale} index={idx} />
              ))}
            </div>

            <!-- Mobile: horizontal swipe pages -->
            <div
              class="md:hidden relative"
              data-carousel-panel={cat.id}
            >
              <div class="overflow-x-auto snap-x snap-mandatory flex gap-3 scrollbar-none pb-2 -mx-1 px-1">
                {pages.map((page, pageIdx) => (
                  <div class="snap-start shrink-0 w-[88%] last:w-full">
                    <div class="grid grid-cols-2 gap-2.5">
                      {page.map((service, idx) => (
                        <ServiceCard service={service} locale={locale} index={idx} />
                      ))}
                    </div>
                  </div>
                ))}
              </div>
              <!-- Dots -->
              {pages.length > 1 && (
                <div class="flex items-center justify-center gap-1.5 mt-3" data-carousel-dots={cat.id}>
                  {pages.map((_, pIdx) => (
                    <span
                      class:list={[
                        "w-1.5 h-1.5 rounded-full transition-all duration-300",
                        pIdx === 0 ? "bg-gold w-4" : "bg-border",
                      ]}
                      data-dot={pIdx}
                    />
                  ))}
                </div>
              )}
            </div>
          </div>
        );
      })}
    </div>
  </div>
</section>

<style>
  .scrollbar-none::-webkit-scrollbar { display: none; }
  .scrollbar-none { -ms-overflow-style: none; scrollbar-width: none; }
</style>

<script>
  // Category tabs
  const tabs = document.querySelectorAll('[data-category]');
  const panels = document.querySelectorAll('[data-panel]');

  tabs.forEach(tab => {
    tab.addEventListener('click', () => {
      const category = tab.dataset.category;
      if (!category) return;

      tabs.forEach(t => {
        const isActive = t.dataset.category === category;
        t.setAttribute('aria-selected', isActive.toString());
        if (isActive) {
          t.classList.add('bg-gold', 'text-bg', 'shadow-lg', 'shadow-gold/20');
          t.classList.remove('bg-bg-elevated', 'text-text-muted', 'hover:text-text', 'hover:bg-bg-card', 'hover:border-gold/50', 'border', 'border-border');
        } else {
          t.classList.remove('bg-gold', 'text-bg', 'shadow-lg', 'shadow-gold/20');
          t.classList.add('bg-bg-elevated', 'text-text-muted', 'hover:text-text', 'hover:bg-bg-card', 'hover:border-gold/50', 'border', 'border-border');
        }
      });

      panels.forEach(p => {
        const isActive = p.dataset.panel === category;
        if (isActive) {
          p.classList.remove('hidden');
          p.classList.add('animate-in');
        } else {
          p.classList.add('hidden');
          p.classList.remove('animate-in');
        }
      });
    });
  });

  // Mobile carousel scroll tracking
  document.querySelectorAll<HTMLElement>('[data-carousel-panel]').forEach(carousel => {
    const scroll = carousel.querySelector<HTMLElement>('.overflow-x-auto');
    const catId = carousel.dataset.carouselPanel;
    const dotsContainer = carousel.querySelector<HTMLElement>(`[data-carousel-dots="${catId}"]`);
    if (!scroll || !dotsContainer) return;

    const pages = scroll.querySelectorAll<HTMLElement>('.snap-start');
    const dots = dotsContainer.querySelectorAll<HTMLElement>('[data-dot]');
    let current = 0;

    scroll.addEventListener('scroll', () => {
      const scrollLeft = scroll.scrollLeft;
      const pageWidth = pages[0]?.offsetWidth || 1;
      const newCurrent = Math.round(scrollLeft / pageWidth);
      if (newCurrent !== current && newCurrent >= 0 && newCurrent < pages.length) {
        current = newCurrent;
        dots.forEach((dot, i) => {
          if (i === current) {
            dot.classList.add('bg-gold', 'w-4');
            dot.classList.remove('bg-border');
          } else {
            dot.classList.remove('bg-gold', 'w-4');
            dot.classList.add('bg-border');
          }
        });
      }
    }, { passive: true });
  });
</script>

<script define:vars={{ labelMap, locale }}>
  // ── Dynamic services from Supabase (fallback on static SSR content) ──
  const categoryLabels = labelMap;
  const MOBILE_PAGE_SIZE = 3;

  function esc(str) {
    return String(str ?? "").replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;");
  }
  function catLabel(catId) {
    const l = categoryLabels[catId] || {};
    return l[locale] || catId;
  }
  function badgeLabel(catId) {
    if (catId === "men") return "Barbier";
    if (catId === "women") return "Coiffure";
    return "Tresses";
  }

  function initCarousel(panel) {
    const carousel = panel.querySelector('[data-carousel-panel]');
    if (!carousel) return;
    const catId = carousel.dataset.carouselPanel;
    const scroll = carousel.querySelector('.overflow-x-auto');
    const dotsContainer = carousel.querySelector(`[data-carousel-dots="${catId}"]`);
    if (!scroll || !dotsContainer) return;
    const pages = scroll.querySelectorAll('.snap-start');
    const dots = dotsContainer.querySelectorAll('[data-dot]');
    let current = 0;
    scroll.addEventListener('scroll', () => {
      const scrollLeft = scroll.scrollLeft;
      const pageWidth = pages[0]?.offsetWidth || 1;
      const newCurrent = Math.round(scrollLeft / pageWidth);
      if (newCurrent !== current && newCurrent >= 0 && newCurrent < pages.length) {
        current = newCurrent;
        dots.forEach((dot, i) => {
          if (i === current) {
            dot.classList.add('bg-gold', 'w-4');
            dot.classList.remove('bg-border');
          } else {
            dot.classList.remove('bg-gold', 'w-4');
            dot.classList.add('bg-border');
          }
        });
      }
    }, { passive: true });
  }

  function cardHTML(s, idx) {
    const desc = (s.description && s.description[locale]) || "";
    return `<article class="card group animate-in stagger-${(idx % 7) + 1}">
      <div class="p-2.5 md:p-6">
        <div class="mb-1 md:mb-3">
          <span class="text-[9px] md:text-xs inline-flex items-center rounded-full px-1.5 py-0.5 md:px-3 md:py-1 font-medium bg-gold/10 text-gold border border-gold/20">${badgeLabel(s.category)}</span>
        </div>
        <div class="flex flex-col gap-0.5 md:flex-row md:items-start md:justify-between md:gap-4 mb-1 md:mb-2">
          <h3 class="text-xs md:heading-sm text-text group-hover:text-gold transition-colors leading-snug line-clamp-2">${esc(s.name[locale])}</h3>
          <span class="font-display font-bold text-xs md:text-lg text-gold whitespace-nowrap">${esc(s.priceEur)}</span>
        </div>
        <div class="flex items-center gap-3 mb-1.5 md:mb-4 text-[10px] md:text-sm text-text-muted">
          <span class="flex items-center gap-0.5 md:gap-1">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
            ${esc(s.duration[locale] || "")}
          </span>
        </div>
        <p class="text-xs md:text-sm text-text-muted mb-2 md:mb-4 line-clamp-2 hidden md:block">${esc(desc)}</p>
        <a href="#booking" class="text-[10px] md:text-sm w-full justify-center group-hover:border-gold/50 group-hover:text-gold transition-all inline-flex items-center gap-1 rounded-lg px-2 py-1 md:px-6 md:py-3 font-semibold bg-bg-elevated text-text border border-border hover:bg-bg-card hover:border-gold/50" data-service="${esc(s.id)}">
          ${locale === "fr" ? "Réserver" : "Book"}
        </a>
      </div>
    </article>`;
  }

  function renderPanels(servicesList) {
    const byCat = {};
    for (const s of servicesList) {
      if (!byCat[s.category]) byCat[s.category] = [];
      byCat[s.category].push(s);
    }
    for (const cat of Object.keys(categoryLabels)) {
      const panel = document.querySelector(`[data-panel="${cat}"]`);
      if (!panel) continue;
      const list = byCat[cat] || [];
      const desktop = panel.querySelector(".hidden.md\\:grid");
      const mobileWrap = panel.querySelector(".md\\:hidden");

      if (desktop) {
        desktop.innerHTML = list.map(cardHTML).join("");
      }
      if (mobileWrap) {
        const pages = [];
        for (let p = 0; p < list.length; p += MOBILE_PAGE_SIZE) pages.push(list.slice(p, p + MOBILE_PAGE_SIZE));
        const dots = pages.length > 1
          ? `<div class="flex items-center justify-center gap-1.5 mt-3" data-carousel-dots="${cat}">
               ${pages.map((_, i) => `<span class="w-1.5 h-1.5 rounded-full transition-all duration-300 ${i === 0 ? "bg-gold w-4" : "bg-border"}" data-dot="${i}"></span>`).join("")}
             </div>`
          : "";
        mobileWrap.innerHTML = `<div class="overflow-x-auto snap-x snap-mandatory flex gap-3 scrollbar-none pb-2 -mx-1 px-1">
            ${pages.map(page => `<div class="snap-start shrink-0 w-[88%] last:w-full"><div class="grid grid-cols-2 gap-2.5">${page.map(cardHTML).join("")}</div></div>`).join("")}
          </div>${dots}`;
      }
      initCarousel(panel);
    }

    // rebind service buttons
    document.querySelectorAll('[data-service]').forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        const id = btn.getAttribute('data-service');
        const booking = document.getElementById('booking');
        if (booking) {
          booking.scrollIntoView({ behavior: 'smooth' });
          setTimeout(() => window.dispatchEvent(new CustomEvent('arc:select-service', { detail: id })), 500);
        }
      });
    });
  }

  (async function loadServices() {
    try {
      const res = await fetch('/api/services/', { headers: { Accept: 'application/json' } });
      if (!res.ok) return;
      const json = await res.json();
      if (json && Array.isArray(json.services) && json.services.length) {
        renderPanels(json.services);
      }
    } catch {
      // keep static SSR content
    }
  })();
</script>
