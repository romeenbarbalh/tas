---
interface Props {
  locale: "fr" | "en";
  t: (key: string) => string;
}
const { locale, t } = Astro.props;
import { galleryImages } from "../../utils/constants";

const MOBILE_PAGE_SIZE = 4;
const pages: typeof galleryImages[] = [];
for (let p = 0; p < galleryImages.length; p += MOBILE_PAGE_SIZE) {
  pages.push(galleryImages.slice(p, p + MOBILE_PAGE_SIZE));
}
---

<section id="gallery" class="section bg-bg-elevated/30" aria-labelledby="gallery-title">
  <div class="container">
    <header class="text-center max-w-2xl mx-auto mb-4 md:mb-12">
      <h2 id="gallery-title" class="heading-lg mb-1 md:mb-4">{t("gallery.title")}</h2>
      <p class="text-body hidden md:block">{t("gallery.subtitle")}</p>
    </header>

    <!-- Desktop: grid -->
    <div class="hidden md:grid grid-cols-2 gap-2 md:gap-4 lg:grid-cols-3 xl:grid-cols-4" role="list">
      {galleryImages.map((img, idx) => (
        <figure class="relative aspect-[4/5] rounded-xl overflow-hidden group card cursor-zoom-in animate-in stagger-{idx + 1}" role="listitem" data-lightbox={img.src}>
          <img
            src={img.src}
            alt={img.alt[locale]}
            class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
            loading="lazy"
          />
          <figcaption class="absolute inset-0 bg-gradient-to-t from-bg/90 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-end p-4">
            <span class="text-sm font-medium text-text w-full text-center">{img.alt[locale]}</span>
          </figcaption>
          <div class="absolute top-3 right-3 p-2 rounded-full bg-bg/90 backdrop-blur-sm border border-border text-text-muted opacity-0 group-hover:opacity-100 transition-opacity duration-300" aria-hidden="true">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="16"></line><line x1="8" y1="12" x2="16" y2="12"></line></svg>
          </div>
        </figure>
      ))}
    </div>

    <!-- Mobile: horizontal swipe pages (2x2 grid) -->
    <div class="md:hidden relative">
      <div class="overflow-x-auto snap-x snap-mandatory flex gap-2.5 scrollbar-none pb-2 -mx-1 px-1">
        {pages.map((page) => (
          <div class="snap-start shrink-0 w-[88%] last:w-full">
            <div class="grid grid-cols-2 gap-2">
              {page.map((img, idx) => (
                <figure class="relative aspect-[4/5] rounded-lg overflow-hidden group cursor-zoom-in" role="listitem" data-lightbox={img.src}>
                  <img
                    src={img.src}
                    alt={img.alt[locale]}
                    class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                    loading="lazy"
                  />
                  <figcaption class="absolute inset-0 bg-gradient-to-t from-bg/90 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-end p-2">
                    <span class="text-[10px] font-medium text-text w-full text-center">{img.alt[locale]}</span>
                  </figcaption>
                </figure>
              ))}
            </div>
          </div>
        ))}
      </div>
      {pages.length > 1 && (
        <div class="flex items-center justify-center gap-1.5 mt-3" data-carousel-dots="gallery">
          {pages.map((_, pIdx) => (
            <span
              class:list={[
                "w-1.5 h-1.5 rounded-full transition-all duration-300",
                pIdx === 0 ? "bg-gold w-4" : "bg-border",
              ]}
              data-dot={pIdx}
            />
          ))}
        </div>
      )}
    </div>

    <!-- Lightbox (CSS-only) -->
    <div class="fixed inset-0 z-[var(--z-modal)] hidden" id="lightbox" role="dialog" aria-modal="true" aria-label={locale === "fr" ? "Agrandir l'image" : "Enlarge image"}>
      <div class="absolute inset-0 bg-black/95 backdrop-blur-sm" aria-hidden="true"></div>
      <button class="absolute top-6 right-6 z-10 p-2 rounded-full bg-bg/80 backdrop-blur-sm border border-border text-text-muted hover:text-text hover:border-gold/50 transition-colors" aria-label={locale === "fr" ? "Fermer" : "Close"} data-lightbox-close>
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
      </button>
      <button class="absolute left-6 top-1/2 -translate-y-1/2 z-10 p-3 rounded-full bg-bg/80 backdrop-blur-sm border border-border text-text-muted hover:text-text hover:border-gold/50 transition-colors md:hidden" aria-label={locale === "fr" ? "Précédent" : "Previous"} data-lightbox-prev>
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"></polyline></svg>
      </button>
      <button class="absolute right-6 top-1/2 -translate-y-1/2 z-10 p-3 rounded-full bg-bg/80 backdrop-blur-sm border border-border text-text-muted hover:text-text hover:border-gold/50 transition-colors md:hidden" aria-label={locale === "fr" ? "Suivant" : "Next"} data-lightbox-next>
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
      </button>
      <div class="absolute inset-0 flex items-center justify-center p-4">
        <figure class="max-w-4xl max-h-[90vh] w-full">
          <img id="lightbox-img" src="" alt="" class="max-w-full max-h-[90vh] object-contain rounded-lg shadow-2xl" />
          <figcaption id="lightbox-caption" class="text-center mt-4 text-text-muted text-sm"></figcaption>
        </figure>
      </div>
    </div>
  </div>
</section>

<style>
  .scrollbar-none::-webkit-scrollbar { display: none; }
  .scrollbar-none { -ms-overflow-style: none; scrollbar-width: none; }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-carousel-dots="gallery"]').forEach(dotsContainer => {
    const scroll = dotsContainer.previousElementSibling?.querySelector<HTMLElement>('.overflow-x-auto');
    if (!scroll) return;

    const pages = scroll.querySelectorAll<HTMLElement>('.snap-start');
    const dots = dotsContainer.querySelectorAll<HTMLElement>('[data-dot]');
    let current = 0;

    scroll.addEventListener('scroll', () => {
      const pageWidth = pages[0]?.offsetWidth || 1;
      const newCurrent = Math.round(scroll.scrollLeft / pageWidth);
      if (newCurrent !== current && newCurrent >= 0 && newCurrent < pages.length) {
        current = newCurrent;
        dots.forEach((dot, i) => {
          if (i === current) {
            dot.classList.add('bg-gold', 'w-4');
            dot.classList.remove('bg-border');
          } else {
            dot.classList.remove('bg-gold', 'w-4');
            dot.classList.add('bg-border');
          }
        });
      }
    }, { passive: true });
  });

  // Lightbox functionality
  const lightbox = document.getElementById('lightbox');
  const lightboxImg = document.getElementById('lightbox-img');
  const lightboxCaption = document.getElementById('lightbox-caption');
  const triggers = document.querySelectorAll('[data-lightbox]');
  const closeBtn = document.querySelector('[data-lightbox-close]');
  const prevBtn = document.querySelector('[data-lightbox-prev]');
  const nextBtn = document.querySelector('[data-lightbox-next]');

  let currentIndex = 0;
  const images = Array.from(triggers).map(el => ({
    src: el.dataset.lightbox,
    alt: el.querySelector('img')?.alt || ''
  }));

  function openLightbox(index: number) {
    currentIndex = index;
    updateLightbox();
    lightbox.classList.remove('hidden');
    lightbox.classList.add('flex');
    document.body.style.overflow = 'hidden';
    document.addEventListener('keydown', handleKeydown);
  }

  function closeLightbox() {
    lightbox.classList.add('hidden');
    lightbox.classList.remove('flex');
    document.body.style.overflow = '';
    document.removeEventListener('keydown', handleKeydown);
  }

  function updateLightbox() {
    const img = images[currentIndex];
    lightboxImg.src = img.src;
    lightboxImg.alt = img.alt;
    lightboxCaption.textContent = img.alt;
  }

  function navigate(direction: number) {
    currentIndex = (currentIndex + direction + images.length) % images.length;
    updateLightbox();
  }

  function handleKeydown(e: KeyboardEvent) {
    if (e.key === 'Escape') closeLightbox();
    if (e.key === 'ArrowLeft') navigate(-1);
    if (e.key === 'ArrowRight') navigate(1);
  }

  triggers.forEach((trigger, index) => {
    trigger.addEventListener('click', () => openLightbox(index));
  });

  closeBtn?.addEventListener('click', closeLightbox);
  prevBtn?.addEventListener('click', () => navigate(-1));
  nextBtn?.addEventListener('click', () => navigate(1));

  lightbox?.addEventListener('click', (e) => {
    if (e.target === lightbox) closeLightbox();
  });

  let touchStartX = 0;
  lightbox?.addEventListener('touchstart', (e) => { touchStartX = e.touches[0].clientX; }, { passive: true });
  lightbox?.addEventListener('touchend', (e) => {
    const touchEndX = e.changedTouches[0].clientX;
    const diff = touchStartX - touchEndX;
    if (Math.abs(diff) > 50) navigate(diff > 0 ? 1 : -1);
  }, { passive: true });
</script>
