---
interface Props {
  title: string;
}
const { title } = Astro.props;
import "../styles/admin.css";
import {
  LayoutDashboard,
  Images,
  Settings,
  LogOut,
  ExternalLink,
  Scissors,
} from "lucide-react";
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title} — The Ark Studio Admin</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Syne:wght@400;500;600;700;800&display=swap" />
  </head>

  <body class="min-h-screen bg-background text-white font-sans antialiased">
    <nav class="sticky top-0 z-50 border-b border-white/8 bg-background/85 backdrop-blur-xl">
      <div class="mx-auto flex max-w-7xl items-center justify-between px-5 py-3 sm:px-8">
        <div class="flex items-center gap-3">
          <span class="flex h-10 w-10 items-center justify-center rounded-full border border-gold/30 bg-gold/10 text-gold">
            <Scissors class="h-5 w-5" />
          </span>
          <div>
            <a href="/admin/dashboard" class="font-serif text-lg font-bold leading-none tracking-tight text-white">
              The Ark <span class="text-gold">Studio</span>
            </a>
            <p class="text-[11px] text-muted">Administration</p>
          </div>
        </div>

        <div class="flex items-center gap-2">
          <a href="/" class="hidden items-center gap-1.5 rounded-lg border border-white/10 px-3 py-2 text-xs font-semibold text-muted transition-colors hover:border-gold/40 hover:text-gold sm:inline-flex">
            <ExternalLink class="h-4 w-4" />
            Site
          </a>
          <button id="logout-btn" class="inline-flex items-center gap-1.5 rounded-lg bg-gold px-3 py-2 text-xs font-semibold text-background transition-colors hover:bg-gold-light">
            <LogOut class="h-4 w-4" />
            Déconnexion
          </button>
        </div>
      </div>

      <div class="mx-auto flex max-w-7xl gap-1 px-5 pb-3 sm:px-8">
        <a
          href="/admin/dashboard"
          class={`inline-flex flex-1 items-center justify-center gap-2 rounded-full px-4 py-2 text-sm font-semibold transition-colors sm:flex-none ${
            title === "Rendez-vous"
              ? "border border-gold/40 bg-gold/15 text-gold"
              : "border border-transparent text-muted hover:text-white"
          }`}
        >
          <LayoutDashboard class="h-4 w-4" />
          Rendez-vous
        </a>
        <a
          href="/admin/gallery"
          class={`inline-flex flex-1 items-center justify-center gap-2 rounded-full px-4 py-2 text-sm font-semibold transition-colors sm:flex-none ${
            title === "Galerie"
              ? "border border-gold/40 bg-gold/15 text-gold"
              : "border border-transparent text-muted hover:text-white"
          }`}
        >
          <Images class="h-4 w-4" />
          Galerie
        </a>
        <a
          href="/admin/account"
          class={`inline-flex flex-1 items-center justify-center gap-2 rounded-full px-4 py-2 text-sm font-semibold transition-colors sm:flex-none ${
            title === "Compte"
              ? "border border-gold/40 bg-gold/15 text-gold"
              : "border border-transparent text-muted hover:text-white"
          }`}
        >
          <Settings class="h-4 w-4" />
          Compte
        </a>
      </div>
    </nav>

    <main class="mx-auto max-w-7xl px-5 py-8 sm:px-8">
      <slot />
    </main>

    <script>
      import { supabase } from "../lib/supabase";

      document.getElementById("logout-btn")?.addEventListener("click", async () => {
        await supabase.auth.signOut();
        window.location.href = "/admin/";
      });

      supabase.auth.getSession().then(({ data: { session } }) => {
        if (!session && !window.location.pathname.endsWith("/admin/")) {
          window.location.href = "/admin/";
        }
      });
    </script>
  </body>
</html>
